# cluster-kit run config for the multinode Qwen3.5-MoE demo.
#
#   cluster -c examples/training_demo/cluster_qwen3_5_moe.env torchrun -n 4 \
#     scripts/train_lm.py examples/training_demo/train_qwen3_5_moe.yaml \
#     --fsdp_config.dp_shard_size=64 --fsdp_config.edp_shard_size=8 \
#     --training.global_batch_size=64
#
# Node addresses, the SSH user and the interface name are site specific: check
# them before the first launch. The rest applies to any 16-die A3 pool.

# Rank order. NODES[0] is node_rank 0 and becomes MASTER_ADDR, so every node
# (including itself) must be able to reach it. The machine running the kit does
# not have to be in this list.
NODES=(
  192.168.0.55
  192.168.0.143
  192.168.0.71
  192.168.0.215
)

SSH_USER="root"
SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 -o ServerAliveInterval=30"

# /home/tt is a symlink to /mnt/data/tt on every node, so this literal path
# resolves everywhere. Do not use $HOME: it expands once, on the control node.
REPO_DIR="/home/tt/hyper-parallel"
SYNC_DIRS=( "$REPO_DIR" )
SYNC_EXCLUDES=( )

# 16 dies per node. npu-smi info -l reports 8 because it counts chips, not dies.
NPROC_PER_NODE=16
MASTER_PORT=29500

# Outside REPO_DIR so run logs never travel with a sync.
LOG_DIR="/home/tt/cluster_logs"

# Sourced on each node immediately before the job, inside REPO_DIR. It must
# carry everything the job needs: the kit exports only MASTER_ADDR, MASTER_PORT,
# NNODES, NODE_RANK and NPROC_PER_NODE over SSH, so variables exported in the
# calling shell do NOT travel. A machine that is itself in NODES is the
# exception, since it runs locally and inherits that shell, which is how a
# missing setting can appear to work on one node and fail on every other.
#
# The PATH entry pins the interpreter: a remote non-login shell can otherwise
# resolve a different python first, and the resulting failure is visible only in
# the kit's node logs, never in a training log.
REMOTE_ENV_SETUP="source /home/tt/init_env.sh; export PATH=/home/tt/envs/hp2/bin:\$PATH; export HCCL_SOCKET_IFNAME=enp23s0f3; export HCCL_IF_BASE_PORT=62600; export HCCL_NPU_SOCKET_PORT_RANGE=60000-60100; export HCCL_CONNECT_TIMEOUT=1200; export HCCL_EXEC_TIMEOUT=1800"
